PORT=3000
NODE_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_real_key
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# [필수] RLS가 적용되도록 맛집 쓰기 요청을 사용자 토큰과 이 공개 키로 보냅니다.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
# 네이버 OIDC 공급자를 등록하는 초기 설정 명령에서만 사용합니다.
# 일반 Express 요청 처리에는 필요하지 않습니다. VITE_*에 넣지 않습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# RLS 실계정 검증(npm run test:rls)용 테스트 계정 (선택)
API_URL=http://localhost:3000
RLS_MEMBER_A_EMAIL=
RLS_MEMBER_A_PASSWORD=
RLS_MEMBER_B_EMAIL=
RLS_MEMBER_B_PASSWORD=
RLS_ADMIN_EMAIL=
RLS_ADMIN_PASSWORD=
